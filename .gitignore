# Rust
/target
**/*.rs.bk

# ci/downstream-gate is its own workspace root, so it builds its own target/.
# Its Cargo.lock is deliberately not committed either: the gate's job is to
# resolve the way a fresh downstream consumer would, and a pinned lock would
# hide a drift the gate exists to catch.
/ci/downstream-gate/target
/ci/downstream-gate/Cargo.lock

# OS
Thumbs.db
.DS_Store

# IDE
.idea/
.vscode/
*.iml

# Env
.env
.envrc

# Claude local overrides (keep shared .claude/ config, ignore local-only)
.claude/settings.local.json

# Reference copy of the pre-sindon Tauri knot app — kept locally for
# parity checks during migration, not part of this workspace.
/knot-notes-app-v0.7.0-2026-04-27/
